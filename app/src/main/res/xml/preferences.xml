<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="Authentication">
        <CheckBoxPreference
            android:key="enable_auth"
            android:title="Enable Authentication"
            android:summary="Require username/password to access the stream"
            android:defaultValue="true" />
        <EditTextPreference
            android:key="username"
            android:title="Username"
            android:defaultValue=""
            android:singleLine="true" />
        <EditTextPreference
            android:key="password"
            android:title="Password"
            android:defaultValue=""
            android:inputType="textPassword"
            android:singleLine="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Startup &amp; Network">
        <CheckBoxPreference
            android:key="start_on_boot"
            android:title="Start on Boot"
            android:summary="Start the camera server automatically after the device restarts"
            android:defaultValue="false" />
        <EditTextPreference
            android:key="server_port"
            android:title="Streaming Port"
            android:summary="Port for the streaming server (default: 4444)"
            android:defaultValue="4444"
            android:inputType="number"
            android:singleLine="true" />
        <ListPreference
            android:key="listen_interface"
            android:title="Listen Interface"
            android:summary="Interface the server listens on (default: all interfaces)"
            android:defaultValue="0.0.0.0" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Stream Quality &amp; Latency">
        <ListPreference
            android:key="stream_quality"
            android:title="JPEG Quality"
            android:summary="Compression quality for MJPEG stream"
            android:defaultValue="85"
            android:entries="@array/stream_quality_entries"
            android:entryValues="@array/stream_quality_values" />
        <ListPreference
            android:key="stream_bitrate"
            android:title="Bitrate Target / Limit"
            android:summary="Maximum bitrate cap or unlimited for maximum quality"
            android:defaultValue="0"
            android:entries="@array/stream_bitrate_entries"
            android:entryValues="@array/stream_bitrate_values" />
        <ListPreference
            android:key="focus_mode"
            android:title="Default Focus Mode"
            android:summary="Camera focus behavior"
            android:defaultValue="continuous"
            android:entries="@array/focus_mode_entries"
            android:entryValues="@array/focus_mode_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Certificate Settings">
        <CheckBoxPreference
            android:key="tls_enabled"
            android:title="Enable TLS/HTTPS"
            android:summary="Secure HTTP connection with SSL/TLS"
            android:defaultValue="true" />
        <ListPreference
            android:key="tls_version"
            android:title="TLS Version"
            android:summary="Automatically use the newest platform TLS or force TLS 1.2"
            android:defaultValue="1.3"
            android:entries="@array/tls_version_entries"
            android:entryValues="@array/tls_version_values" />
        <Preference
            android:key="certificate_path"
            android:title="Custom TLS Certificate" android:summary="Select your own certificate" android:persistent="true" />
        <EditTextPreference
            android:key="certificate_password"
            android:title="Certificate Password"
            android:summary="Optional password for the TLS certificate"
            android:persistent="true"
            android:inputType="textPassword" />
        <Preference
            android:key="test_certificate"
            android:title="Test Certificate Setup"
            android:summary="Validate your certificate configuration"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
